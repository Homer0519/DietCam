{
  "llm_mode": {
    "description": "视觉模型接入方式",
    "type": "string",
    "options": [
      "openai_compatible",
      "astrbot_provider"
    ],
    "default": "openai_compatible",
    "hint": "openai_compatible = 插件自己按 OpenAI 格式请求你的多模态模型；astrbot_provider = 复用 AstrBot 里已配置的模型提供商（需支持图片输入）"
  },
  "base_url": {
    "description": "OpenAI 兼容接口地址",
    "type": "string",
    "default": "http://127.0.0.1:8000/v1",
    "hint": "结尾到 /v1 即可，插件会自动拼接 /chat/completions"
  },
  "api_key": {
    "description": "接口 API Key（本地模型可留空）",
    "type": "string",
    "default": ""
  },
  "model": {
    "description": "模型名称",
    "type": "string",
    "default": "qwen2.5-vl-7b-instruct"
  },
  "extra_headers": {
    "description": "额外请求头(JSON)",
    "type": "string",
    "default": "{}"
  },
  "extra_body": {
    "description": "额外请求体字段(JSON)",
    "type": "string",
    "default": "{}"
  },
  "astrbot_provider_id": {
    "description": "AstrBot 提供商 ID（llm_mode=astrbot_provider 时使用）",
    "type": "string",
    "default": "",
    "hint": "留空则使用当前默认提供商；需为支持图片的多模态模型"
  },
  "request_timeout": {
    "description": "模型请求超时(秒)",
    "type": "int",
    "default": 120
  },
  "hmac_secret": {
    "description": "APP 上传签名密钥",
    "type": "string",
    "default": "change-me-dietcam-secret",
    "hint": "必须与 APP 端设置里填写的密钥完全一致，用于防止接口被公网滥用"
  },
  "timezone_offset_hours": {
    "description": "时区偏移(小时)",
    "type": "int",
    "default": 8
  },
  "remember_umo": {
    "description": "记录最近会话用于主动推送",
    "type": "bool",
    "default": true,
    "hint": "只记录会话标识，不会主动发消息"
  },
  "analyze_prompt": {
    "description": "自定义分析提示词",
    "type": "text",
    "default": ""
  },
  "analyze_prompt_text": {
    "description": "纯文字模式的分析提示词",
    "type": "text",
    "default": "",
    "hint": "APP 里不拍照、直接打字描述吃了什么时使用；留空用内置营养师提示词"
  },
  "target_calories_kcal": {
    "description": "每日热量目标（kcal）",
    "type": "int",
    "default": 2000,
    "hint": "APP 主页会用它画进度条；也可以在 APP 里直接改，改动存在 state.json，优先级高于这里"
  },
  "target_protein_g": {
    "description": "每日蛋白质目标（g）",
    "type": "int",
    "default": 75
  },
  "target_carbs_g": {
    "description": "每日碳水目标（g）",
    "type": "int",
    "default": 250
  },
  "target_fat_g": {
    "description": "每日脂肪目标（g）",
    "type": "int",
    "default": 65
  }
}

# 本仓库是「AstrBot 插件开发」用的多项目仓库，每个项目一个子目录。
# 下面的规则按项目分组，新增项目时照抄一段即可。

# ---------------------------------------------------------------- 通用

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
*.iml

# Android 构建产物（任何项目通用）
*.apk
*.aab
captures/

# ---------------------------------------------------------------- DietCam

dietcam/android/.gradle/
dietcam/android/build/
dietcam/android/app/build/
dietcam/android/local.properties

# 本机构建工具链（Android SDK + Gradle，约 1.9 GB，不要提交）
dietcam/.toolchain/

# 打包产物（由 tools/package_plugin.py 生成，不入库）
dietcam/dist/*.zip
dietcam/dist/*.bundle

# 测试 / 演示临时数据
dietcam/.demo_data/
dietcam/.selftest_data/
dietcam/.ziptest/

# 签名口令不该进版本库（密钥库 .jks 本身要留着 —— 覆盖升级靠它）：
#   git rm --cached dietcam/android/keystore.properties
dietcam/android/keystore.properties
